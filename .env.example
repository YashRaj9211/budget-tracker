# -----------------------------------------------------------------------------
# Frontend Environment Template (.env.example)
# Copy this file to .env and fill in the required keys
# -----------------------------------------------------------------------------

# Backend API Configuration
# Local Go server: http://localhost:3001
# Production Go server (Render): https://divvit.onrender.com
VITE_API_URL=http://localhost:3001

# WebSocket Base URL (Optional override)
VITE_WS_URL=ws://localhost:3001

# Application Frontend URL
VITE_APP_URL=http://localhost:5173

# AI Assistant Integration (Google Gemini API Key for voice/smart categorization)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# App Environment ('development' | 'production' | 'staging')
VITE_APP_ENV=development
