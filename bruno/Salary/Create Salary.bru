meta {
  name: Create Salary
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/_private/v1/salary
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "amount": "50000.00",
    "currency": "INR",
    "effectiveFrom": "2026-01-01",
    "note": "Initial base salary"
  }
}

docs {
  # Create Salary Entry (`CreateSalary`)

  **Route**: `POST /api/_private/v1/salary` (Bearer token required)

  Creates a new salary entry for the authenticated user:
  - `amount`: non-negative decimal string (e.g. "50000.00")
  - `effectiveFrom`: starting date in YYYY-MM-DD format
  - `currency`: defaults to "INR"
  - `note`: optional description
}
