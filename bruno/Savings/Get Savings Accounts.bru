meta {
  name: Get Savings Accounts
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/_private/v1/savings-accounts
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

docs {
  # Get Savings Accounts (`GetSavingsAccounts`)

  **Route**: `GET /api/_private/v1/savings-accounts` (Bearer token required)

  Lists all active savings accounts for the user, each including its dynamically calculated `balance` (`openingBalance + deposits - withdrawals`).
}
