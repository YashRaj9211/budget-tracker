# Backend API Configuration
# Local Go server: http://localhost:3001
# Production Go server (Render): https://divvit.onrender.com
VITE_API_URL=http://localhost:3001

# WebSocket Base URL (Optional override; client defaults to deriving from VITE_API_URL)
# Local: ws://localhost:3001
# Production: wss://divvit.onrender.com
VITE_WS_URL=ws://localhost:3001

# Application Frontend URL
VITE_APP_URL=http://localhost:5173

# AI Assistant Integration (Google Gemini API Key for voice/smart categorization)
VITE_GEMINI_API_KEY="AQ.Ab8RN6LAvYy3TlAcOW8YV2h7RPpF8NIKe6Mq37LF1IiEZ27WGw"

# App Environment ('development' | 'production' | 'staging')
VITE_APP_ENV=development